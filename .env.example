# Contoh konfigurasi. Salin menjadi .env (JANGAN commit file .env).
# Cara termudah mengisi dua nilai di bawah:  python -m core.atur_password_cadangan

# SHA-256 (hex, 64 karakter) dari password cadangan admin ("Lupa password").
# Jika kosong, fitur "Lupa password" dimatikan (server menjawab 503).
ADMIN_RECOVERY_HASH=

# Kunci rahasia cookie sesi admin. Jika kosong, dibuat acak tiap server start.
SECRET_KEY=

# Isi 1 jika situs diakses lewat HTTPS (cookie hanya dikirim via HTTPS).
COOKIE_SECURE=0

# Jumlah reverse proxy tepercaya di depan Flask (ProxyFix, lihat core/proxy.py).
# KOSONGKAN saat menjalankan `python app.py` langsung di laptop.
# Di server (Cloudflare Tunnel -> Nginx -> Flask) tentukan lewat
# docs/NGINX_KEAMANAN_ADMIN.md, biasanya 1.
PROXY_COUNT=

# Batas kiriman skor (/api/submit-score) & masukan (/api/submit-feedback) per IP:
# maksimal SUBMIT_BATAS_PER_IP kiriman setiap SUBMIT_JENDELA_DETIK detik.
# Kosong = bawaan 5 kiriman per 600 detik (10 menit). Berlaku untuk app.py & backend/.
# PERHATIAN user testing: semua laptop di Wi-Fi kampus biasanya keluar lewat SATU
# IP publik, jadi naikkan batas ini (mis. 60) selama sesi uji agar skor tidak ditolak.
SUBMIT_BATAS_PER_IP=
SUBMIT_JENDELA_DETIK=
